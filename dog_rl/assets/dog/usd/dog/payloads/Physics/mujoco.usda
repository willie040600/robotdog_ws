        }

        def MjcActuator "FL_thigh_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -0.6981316804885864, -0.010471975430846214, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 5
            uniform double mjc:forceRange:min = -5
            uniform double[] mjc:gainPrm = [0.6981316804885864, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </dog/Physics/FL_thigh_joint>
        }


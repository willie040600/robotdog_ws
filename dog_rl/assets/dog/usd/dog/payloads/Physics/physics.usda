    over "Physics"
    {
        def PhysicsRevoluteJoint "FL_thigh_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.010471975
            float drive:angular:physics:maxForce = 5
            float drive:angular:physics:stiffness = 0.6981317
            uniform token drive:angular:physics:type = "force"
            float newton:damping = 0.0008726646
            float newton:velocityLimit = 572.9578
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </dog/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </dog/Geometry/base_link/FL_thigh>
            point3f physics:localPos0 = (0.1, 0.09, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)

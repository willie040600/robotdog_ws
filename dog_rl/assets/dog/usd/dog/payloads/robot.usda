#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "dog"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "dog" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "FL_thigh_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FR_thigh_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RL_thigh_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RR_thigh_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FL_calf_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FR_calf_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RL_calf_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RR_calf_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "FL_thigh" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "FL_calf" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "FR_thigh" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "FR_calf" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "RL_thigh" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "RL_calf" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "RR_thigh" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "RR_calf" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }
}


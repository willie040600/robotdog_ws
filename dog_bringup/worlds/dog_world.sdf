<?xml version="1.0"?>
<!-- 8 m x 8 m walled room with a few interior walls and boxes for SLAM / Nav2. -->
<sdf version="1.9">
  <world name="dog_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-6 -6 6 0 0.6 0.785</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room">
      <static>true</static>

      <!-- outer walls -->
      <link name="wall_n">
        <pose>0 4 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
      <link name="wall_s">
        <pose>0 -4 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
      <link name="wall_e">
        <pose>4 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
      <link name="wall_w">
        <pose>-4 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.1 0.5</size></box></geometry>
          <material><ambient>0.6 0.5 0.4 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>

      <!-- interior walls -->
      <link name="wall_a">
        <pose>1.5 1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.5 0.5 0.6 1</diffuse></material></visual>
      </link>
      <link name="wall_b">
        <pose>-1.5 -1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.5 0.5 0.6 1</diffuse></material></visual>
      </link>

      <!-- obstacles -->
      <link name="box_1">
        <pose>-2.7 2.2 0.25 0 0 0.4</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
      </link>
      <link name="box_2">
        <pose>2.8 -2.3 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.8 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.4 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>
      </link>
      <link name="cyl_1">
        <pose>0 -2.6 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      </link>
      <link name="cyl_2">
        <pose>2.8 2.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.8 0.7 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>

<?xml version="1.0"?>
<!-- 8-DOF robot dog. Generated from the Fusion model (DogModel.py).
     Frames: X forward, Y left, Z up. Each leg: thigh_joint (base_link->thigh)
     and calf_joint (thigh->calf), both about Y. Foot sphere is part of calf,
     centred at (0, 0, -0.12) in the calf frame, radius 0.015.
     Standing pose: thigh 0.8128, calf -1.6256 rad -> body centre 0.18 m above ground. -->
<robot name="dog">

  <material name="body_grey"><color rgba="0.35 0.35 0.38 1"/></material>
  <material name="leg_dark"><color rgba="0.15 0.15 0.17 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.26 0.11 0.07"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.06 0 0.0425" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.015"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.1 0.06 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.022" length="0.035"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.1 -0.06 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.022" length="0.035"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.1 0.06 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.022" length="0.035"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.1 -0.06 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.022" length="0.035"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.00463 0 0.00304" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="2.550000e-03" ixy="0" ixz="0" iyy="1.087500e-02" iyz="0" izz="1.195500e-02"/>
    </inertial>
  </link>

  <!-- FL leg -->
  <joint name="FL_thigh_joint" type="revolute">
    <parent link="base_link"/>
    <child link="FL_thigh"/>
    <origin xyz="0.1 0.09 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="5" velocity="10"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="FL_thigh">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/thigh.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="leg_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="2.504167e-04" ixy="0" ixz="0" iyy="2.504167e-04" iyz="0" izz="2.083333e-05"/>
    </inertial>
  </link>

  <joint name="FL_calf_joint" type="revolute">
    <parent link="FL_thigh"/>
    <child link="FL_calf"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="-0.6" effort="5" velocity="10"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="FL_calf">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/calf.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="leg_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.12"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06428" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="1.862500e-04" ixy="0" ixz="0" iyy="1.862500e-04" iyz="0" izz="8.000000e-06"/>
    </inertial>
  </link>

  <!-- FR leg -->
  <joint name="FR_thigh_joint" type="revolute">
    <parent link="base_link"/>
    <child link="FR_thigh"/>
    <origin xyz="0.1 -0.09 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="5" velocity="10"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="FR_thigh">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/thigh.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="leg_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="2.504167e-04" ixy="0" ixz="0" iyy="2.504167e-04" iyz="0" izz="2.083333e-05"/>
    </inertial>
  </link>

  <joint name="FR_calf_joint" type="revolute">
    <parent link="FR_thigh"/>
    <child link="FR_calf"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="-0.6" effort="5" velocity="10"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="FR_calf">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/calf.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="leg_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.12"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06428" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="1.862500e-04" ixy="0" ixz="0" iyy="1.862500e-04" iyz="0" izz="8.000000e-06"/>
    </inertial>
  </link>

  <!-- RL leg -->
  <joint name="RL_thigh_joint" type="revolute">
    <parent link="base_link"/>
    <child link="RL_thigh"/>
    <origin xyz="-0.1 0.09 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="5" velocity="10"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="RL_thigh">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/thigh.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="leg_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="2.504167e-04" ixy="0" ixz="0" iyy="2.504167e-04" iyz="0" izz="2.083333e-05"/>
    </inertial>
  </link>

  <joint name="RL_calf_joint" type="revolute">
    <parent link="RL_thigh"/>
    <child link="RL_calf"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="-0.6" effort="5" velocity="10"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="RL_calf">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/calf.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="leg_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.12"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06428" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="1.862500e-04" ixy="0" ixz="0" iyy="1.862500e-04" iyz="0" izz="8.000000e-06"/>
    </inertial>
  </link>

  <!-- RR leg -->
  <joint name="RR_thigh_joint" type="revolute">
    <parent link="base_link"/>
    <child link="RR_thigh"/>
    <origin xyz="-0.1 -0.09 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="5" velocity="10"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="RR_thigh">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/thigh.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="leg_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.025 0.025 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="2.504167e-04" ixy="0" ixz="0" iyy="2.504167e-04" iyz="0" izz="2.083333e-05"/>
    </inertial>
  </link>

  <joint name="RR_calf_joint" type="revolute">
    <parent link="RR_thigh"/>
    <child link="RR_calf"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="-0.6" effort="5" velocity="10"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="RR_calf">
    <visual>
      <geometry><mesh filename="package://dog_description/meshes/calf.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="leg_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.12"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.12" rpy="0 0 0"/>
      <geometry><sphere radius="0.015"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.06428" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="1.862500e-04" ixy="0" ixz="0" iyy="1.862500e-04" iyz="0" izz="8.000000e-06"/>
    </inertial>
  </link>

  <!-- sensor frames (no geometry) -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.06 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 -0.027" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

</robot>
